{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entities"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "learn_url",
          "expected_status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "platform",
              "table",
              "connector",
              "integration"
            ]
          },
          "learn_url": {
            "type": "string",
            "pattern": "^https://learn\\.microsoft\\.com/"
          },
          "expected_status": {
            "enum": [
              "ga",
              "preview",
              "superseded"
            ]
          },
          "article_name": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 40
          },
          "match_text": {
            "type": "string",
            "minLength": 2
          },
          "article_claim": {
            "type": "boolean"
          },
          "deprecation_probe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "phrase"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://learn\\.microsoft\\.com/"
              },
              "phrase": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        }
      }
    }
  }
}
